  "fedora:42"
  "fedora:43"
  "fedora:44"
  "fedora:latest"
  "oraclelinux:7"
  "oraclelinux:7.2"
  "oraclelinux:8"
  "oraclelinux:8.0"
  "oraclelinux:8.6"
  "oraclelinux:8.9"
  "oraclelinux:9"
  "oraclelinux:10"
  "registry.access.redhat.com/ubi8/ubi"
  "registry.access.redhat.com/ubi9/ubi"
  "registry.access.redhat.com/ubi10/ubi"
  "registry.access.redhat.com/rhel7:7.0-21"
