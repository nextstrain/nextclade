#!/usr/bin/env bash
set -euo pipefail

# Run a command on different Linux distros, to ensure compatibility.
# We are mostly concerned about old distros with old glibc, libgcc and kernel.
#
# Current directory will be mounted into the container as `/workdir` and this will be the working dir where
# the container starts. This way the executables and data are accessible starting from `./`
#
# Dependencies:
#   sudo apt-get install -y bash parallel

printf "Docker version:\n"
docker version

export args="${*:?}"

distros=(
  "debian/eol:jessie"  # 8
  "debian/eol:stretch" # 9
  "debian:10.0"
  "debian:11.0"
  "debian:12.0"
  "debian:13.0"
  "debian:stable"
  "debian:testing"
  "debian:sid"
  "debian:latest"
  "ubuntu:14.04"
  "ubuntu:16.04"
  "ubuntu:18.04"
  "ubuntu:20.04"
  "ubuntu:22.04"
  "ubuntu:24.04"
  "ubuntu:26.04"
  "ubuntu:latest"
  "amazonlinux:1"
  "amazonlinux:2"
  "amazonlinux:2023"
  "amazonlinux:2.0.20180622.1"
  "amazonlinux:2.0.20190115"
  "amazonlinux:2.0.20191217.0"
  "amazonlinux:2.0.20200207.1"
  "amazonlinux:2.0.20210126.0"
  "amazonlinux:2.0.20220121.0"
  "amazonlinux:2.0.20230119.1"
  "amazonlinux:2.0.20240131.0"
  "amazonlinux:2.0.20250428.0"
  "amazonlinux:2016.09.0.20161028"
  "amazonlinux:2017.12.0.20171212.2"
  "amazonlinux:latest"
  "centos:7"
  "centos:7.2.1511"
  "centos:7.5.1804"
  "centos:7.9.2009"
  "centos:8"
  "centos:8.1.1911"
  "centos:8.4.2105"
  "fedora:23"
  "fedora:27"
